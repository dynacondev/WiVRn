msgctxt "openxr_post_processing"
msgid "Normal"
msgstr "Normale"

#: client/scenes/gui_settings.cpp:468
msgctxt "openxr_post_processing"
msgid "Quality"
msgstr "Qualità"

#: client/scenes/gui_settings.cpp:470
msgctxt "openxr_post_processing"
msgid "Disabled"
msgstr "Disattivato"

#: client/scenes/gui_settings.cpp:495
msgid "Supersampling"
msgstr "Supersampling"

#: client/scenes/gui_settings.cpp:495
msgid ""
"Reduce flicker for high contrast edges. Useful when the input resolution is "
"high compared to the headset display."
msgstr ""
"Riduce lo sfarfallio sui bordi ad alto contrasto. Utile quando la "
"risoluzione di input è elevata rispetto a quella dello schermo del visore."

#: client/scenes/gui_settings.cpp:496
msgid "Sharpening"
msgstr "Miglioramento della nitidezza"

#: client/scenes/gui_settings.cpp:496
msgid ""
"Improve clarity of high contrast edges and counteract blur. Useful when the "
"input resolution is low compared to the headset display."
msgstr ""
"Migliora la nitidezza dei bordi ad alto contrasto e contrasta l'effetto "
"sfocato. Utile quando la risoluzione di input è bassa rispetto a quella "
"dello schermo del visore."

#: client/scenes/gui_settings.cpp:499
msgid "Post-processing"
msgstr "Post-trattamento"

#: client/scenes/gui_settings.cpp:499
msgctxt "page header subtitle"
msgid "OpenXR layer supersampling and sharpening."
msgstr "Supersampling e nitidezza dei layer OpenXR."

