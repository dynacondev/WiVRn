msgstr "Codec video"

#: client/scenes/gui_settings.cpp:361
msgid "How video is compressed before it is sent to the headset."
msgstr "Come viene compresso il video prima che sia inviato al visore."

#: client/scenes/gui_settings.cpp:383
msgctxt "setting name"
msgid "10-bit color"
msgstr "Colore a 10 bit"

#: client/scenes/gui_settings.cpp:384
msgid "Higher color precision, supported by HEVC and AV1."
msgstr "Maggiore precisione di colore, supportato da HEVC e AV1."

#: client/scenes/gui_settings.cpp:397
msgid "Bitrate"
msgstr "Velocità di trasmissione"

#: client/scenes/gui_settings.cpp:398
msgid "Video data rate sent to the headset."
msgstr "Bitrate video inviato al visore."

#: client/scenes/gui_settings.cpp:413
msgctxt "setting name"
msgid "Foveation center override"
msgstr "Sovrascrittura centro di foveazione"

#: client/scenes/gui_settings.cpp:414
msgid ""
"Manually set where image quality is focused, instead of the center or your "
"gaze."
msgstr ""
"Imposta manualmente dove viene concentrata la qualità dell'immagine, invece "
"che al centro o dove stai guardando."

#: client/scenes/gui_settings.cpp:426
msgctxt "setting name"
msgid "Foveation center"
msgstr "Centro di foveazione"

#: client/scenes/gui_settings.cpp:427
#, c++-format
msgid "Height {:.1f} °, distance {:.2f} m"
msgstr "Altezza {:.1f} °, distanza {:.2f} m"

#: client/scenes/gui_settings.cpp:429
msgctxt "button label to change the foveation center"
msgid "Change"
msgstr "Cambia"

#: client/scenes/gui_settings.cpp:432
msgid "Enable foveation center override to change this setting."
msgstr ""
"Abilita la sovrascrittura centro di foveazione per modificare questa "
"impostazione."

#: client/scenes/gui_settings.cpp:436
msgctxt "page header title"
msgid "Streaming"
msgstr "Streaming"

#: client/scenes/gui_settings.cpp:436
msgctxt "page header subtitle"
msgid "How video is encoded and sent to the headset."
msgstr "Come il video viene codificato e inviato al visore."

#: client/scenes/gui_settings.cpp:441
msgctxt "confirmation messagebox title"
msgid "Disable in-stream window"
msgstr "Disattiva finestra nello stream"

#: client/scenes/gui_settings.cpp:442
msgctxt "confirmation message"
msgid ""
"Do you really want to disable the in-stream window?\n"
"You will not be able to re-open it with the thumbsticks."
msgstr ""
"Vuoi davvero disabilitare la finestra nello stream?\n"
"Non sarà possibile riaprirla utilizzando le levette analogiche."

#: client/scenes/gui_settings.cpp:443 client/scenes/lobby_gui.cpp:886
msgid "Yes"
msgstr "Sì"

#: client/scenes/gui_settings.cpp:444 client/scenes/lobby_gui.cpp:893
msgid "No"
msgstr "No"

