#: client/scenes/gui_settings.cpp:224 client/scenes/gui_settings.cpp:312
#: client/scenes/gui_settings.cpp:507 client/scenes/gui_settings.cpp:589
msgctxt "tooltip for disabled settings"
msgid "Disconnect to change this setting."
msgstr "Bu parametri dəyişmək üçün əlaqəni kəsin."

#: client/scenes/gui_settings.cpp:235
msgid "Refresh rate"
msgstr "Yenilənmə tezliyi"

#: client/scenes/gui_settings.cpp:237
msgid ""
"WiVRn can't directly change the refresh rate on this device. See your "
"device's settings to change the refresh rate."
msgstr ""

#: client/scenes/gui_settings.cpp:238
msgid ""
"Use 'auto' to select the refresh rate based on measured application "
"performance. May cause flicker when a change happens."
msgstr ""
"Yenilənmə tezliyini tətbiqin ölçülmüş performansına əsasən seçmək üçün "
"'Avtomatik' seçin. Dəyişiklik zamanı titrəməyə səbəb ola bilər."

#: client/scenes/gui_settings.cpp:261
msgctxt "automatic refresh rate, use a short string"
msgid "Auto"
msgstr "Avtomatik"

#: client/scenes/gui_settings.cpp:275
msgid "Render resolution"
msgstr "Təsvirin ayırdetmə qabiliyyəti"

#: client/scenes/gui_settings.cpp:276
#, c++-format
msgctxt "render resolution"
msgid "Pixels rendered per eye ({}x{}). Lower to gain performance."
msgstr ""
"Hər göz üçün yaradılan təsvirin pikselləri ({}x{}). Performansı artırmaq "
"üçün azaldın."

#: client/scenes/gui_settings.cpp:293
msgid "Application SpaceWarp"
msgstr "Tətbiq SpaceWarp"

#: client/scenes/gui_settings.cpp:294
msgid "Renders at half the refresh rate. The headset may synthesise frames."
msgstr ""
"Yenilənmə tezliyinin yarısı ilə təsvir yaradır. Qulaqlıq kadrlar sintez edə "
"bilər."

#: client/scenes/gui_settings.cpp:300
msgid "Set a refresh rate other than auto to enable this setting."
msgstr ""
"Bu parametri aktivləşdirmək üçün avtomatikdən fərqli yenilənmə tezliyi seçin."

#: client/scenes/gui_settings.cpp:304
msgctxt "page header title"
msgid "Video"
msgstr "Video"

#: client/scenes/gui_settings.cpp:304
msgctxt "page header subtitle"
msgid "Frame rate and resolution."
msgstr "Kadr tezliyi və ayırdetmə qabiliyyəti."

#: client/scenes/gui_settings.cpp:317
msgid "Foveated encoding"
msgstr "Foveasiyalı kodlaşdırma"

#: client/scenes/gui_settings.cpp:319
msgid ""
"Higher values focus image quality where you look at, improving latency, "
"power efficiency and quality."
msgstr ""
"Daha yüksək dəyərlər görüntü keyfiyyətini baxdığınız yerə cəmləşdirərək "
"gecikməni azaldır, enerji səmərəliliyini və keyfiyyəti artırır."

#: client/scenes/gui_settings.cpp:320
msgid ""
"Higher values focus image quality at the center, improving latency, power "
"efficiency and quality."
msgstr ""
"Daha yüksək dəyərlər görüntü keyfiyyətini mərkəzə cəmləşdirərək gecikməni "
"azaldır, enerji səmərəliliyini və keyfiyyəti artırır."

#: client/scenes/gui_settings.cpp:338 client/scenes/gui_settings.cpp:350
msgctxt "Codec"
msgid "Automatic"
msgstr "Avtomatik"

#: client/scenes/gui_settings.cpp:342
msgctxt "Codec"
msgid "H.264"
msgstr "H.264"

#: client/scenes/gui_settings.cpp:344
msgctxt "Codec"
msgid "HEVC (H.265)"
msgstr "HEVC (H.265)"

#: client/scenes/gui_settings.cpp:346
msgctxt "Codec"
msgid "AV1"
msgstr "AV1"

#: client/scenes/gui_settings.cpp:360 client/scenes/gui_settings.cpp:373
msgctxt "setting name"
msgid "Video codec"
msgstr "Video kodeki"

#: client/scenes/gui_settings.cpp:361
msgid "How video is compressed before it is sent to the headset."
msgstr "Videonun qulaqlığa göndərilməzdən əvvəl necə sıxıldığı."

#: client/scenes/gui_settings.cpp:383
msgctxt "setting name"
msgid "10-bit color"
msgstr "10 bitlik rəng"

#: client/scenes/gui_settings.cpp:384
msgid "Higher color precision, supported by HEVC and AV1."
msgstr "HEVC və AV1 tərəfindən dəstəklənən daha yüksək rəng dəqiqliyi."

#: client/scenes/gui_settings.cpp:397
msgid "Bitrate"
msgstr "Bitreyt"

#: client/scenes/gui_settings.cpp:398
msgid "Video data rate sent to the headset."
msgstr "Qulaqlığa göndərilən video verilənlərinin sürəti."

#: client/scenes/gui_settings.cpp:413
msgctxt "setting name"
msgid "Foveation center override"
msgstr "Foveasiya mərkəzinin əl ilə təyini"

#: client/scenes/gui_settings.cpp:414
msgid ""
"Manually set where image quality is focused, instead of the center or your "
"gaze."
msgstr ""
"Görüntü keyfiyyətinin cəmləşdiyi yeri mərkəz və ya baxış istiqaməti əvəzinə "
"əl ilə təyin edin."

#: client/scenes/gui_settings.cpp:426
msgctxt "setting name"
msgid "Foveation center"
msgstr "Foveasiya mərkəzi"

#: client/scenes/gui_settings.cpp:427
#, c++-format
msgid "Height {:.1f} °, distance {:.2f} m"
msgstr "Hündürlük {:.1f} °, məsafə {:.2f} m"

#: client/scenes/gui_settings.cpp:429
msgctxt "button label to change the foveation center"
msgid "Change"
msgstr "Dəyiş"

#: client/scenes/gui_settings.cpp:432
msgid "Enable foveation center override to change this setting."
msgstr ""
"Bu parametri dəyişmək üçün foveasiya mərkəzinin əl ilə təyinini "
"aktivləşdirin."

#: client/scenes/gui_settings.cpp:436
msgctxt "page header title"
msgid "Streaming"
msgstr "Yayım"

#: client/scenes/gui_settings.cpp:436
msgctxt "page header subtitle"
msgid "How video is encoded and sent to the headset."
msgstr "Videonun necə kodlaşdırıldığı və qulaqlığa göndərildiyi."

#: client/scenes/gui_settings.cpp:441
msgctxt "confirmation messagebox title"
msgid "Disable in-stream window"
msgstr "Yayım zamanı pəncərəni söndür"

#: client/scenes/gui_settings.cpp:442
msgctxt "confirmation message"
msgid ""
"Do you really want to disable the in-stream window?\n"
"You will not be able to re-open it with the thumbsticks."
msgstr ""
"Yayım zamanı pəncərəni söndürmək istədiyinizə əminsiniz?\n"
"Onu analoq çubuqlarla yenidən aça bilməyəcəksiniz."

#: client/scenes/gui_settings.cpp:443 client/scenes/lobby_gui.cpp:886
msgid "Yes"
msgstr "Bəli"

#: client/scenes/gui_settings.cpp:444 client/scenes/lobby_gui.cpp:893
msgid "No"
msgstr "Xeyr"

#: client/scenes/gui_settings.cpp:465
msgctxt "openxr_post_processing"
msgid "Normal"
msgstr "Normal"

#: client/scenes/gui_settings.cpp:468
msgctxt "openxr_post_processing"
msgid "Quality"
msgstr "Keyfiyyət"

#: client/scenes/gui_settings.cpp:470
msgctxt "openxr_post_processing"
msgid "Disabled"
msgstr "Deaktiv"

#: client/scenes/gui_settings.cpp:495
msgid "Supersampling"
msgstr "Yüksək ayırdetmə qabiliyyətində nümunələmə"

#: client/scenes/gui_settings.cpp:495
msgid ""
"Reduce flicker for high contrast edges. Useful when the input resolution is "
"high compared to the headset display."
msgstr ""
"Yüksək kontrastlı kənarlarda titrəməni azaldın. Giriş ayırdetmə qabiliyyəti "
"qulaqlığın ekranına nisbətən yüksək olduqda faydalıdır."

#: client/scenes/gui_settings.cpp:496
msgid "Sharpening"
msgstr "Kəskinləşdirmə"

#: client/scenes/gui_settings.cpp:496
msgid ""
"Improve clarity of high contrast edges and counteract blur. Useful when the "
"input resolution is low compared to the headset display."
msgstr ""
"Yüksək kontrastlı kənarların aydınlığını artırın və bulanıqlığı azaldın. "
"Giriş ayırdetmə qabiliyyəti qulaqlığın ekranına nisbətən aşağı olduqda "
"faydalıdır."

#: client/scenes/gui_settings.cpp:499
msgid "Post-processing"
msgstr "Sonrakı emal"

#: client/scenes/gui_settings.cpp:499
msgctxt "page header subtitle"
msgid "OpenXR layer supersampling and sharpening."
msgstr ""
"OpenXR qatında yüksək ayırdetmə qabiliyyətində nümunələmə və kəskinləşdirmə."

#: client/scenes/gui_settings.cpp:512
msgctxt "setting name"
msgid "Microphone"
msgstr "Mikrofon"

#: client/scenes/gui_settings.cpp:513
msgid "Stream the headset microphone to the PC."
msgstr "Qulaqlığın mikrofon səsini kompüterə ötürün."

#: client/scenes/gui_settings.cpp:525
msgctxt "setting name"
msgid "Unprocessed audio"
msgstr "Emal olunmamış səs"

#: client/scenes/gui_settings.cpp:526
msgid "Disable audio filters, such as noise cancellation."
msgstr "Səs-küyün aradan qaldırılması kimi səs süzgəclərini söndürün."

#: client/scenes/gui_settings.cpp:536
msgctxt "page header title"
msgid "Audio"
msgstr "Səs"

#: client/scenes/gui_settings.cpp:536
msgctxt "page header subtitle"
msgid "Microphone streamed to the PC."
msgstr "Kompüterə ötürülən mikrofon səsi."

#: client/scenes/gui_settings.cpp:549
msgctxt "setting name"
msgid "Keyboard"
msgstr "Klaviatura"

#: client/scenes/gui_settings.cpp:550
msgid "Forward the keyboard from the headset to the PC."
msgstr "Klaviaturanı qulaqlıqdan kompüterə yönləndirin."

#: client/scenes/gui_settings.cpp:559
msgctxt "setting name"
msgid "Mouse"
msgstr "Siçan"

#: client/scenes/gui_settings.cpp:560
msgid "Forward the mouse from the headset to the PC."
msgstr "Siçanı qulaqlıqdan kompüterə yönləndirin."

#: client/scenes/gui_settings.cpp:570
msgctxt "setting name"
msgid "Gamepad"
msgstr "Oyun pultu"

#: client/scenes/gui_settings.cpp:571
msgid "Forward the gamepad from the headset to the PC."
msgstr "Oyun pultunu qulaqlıqdan kompüterə yönləndirin."

#: client/scenes/gui_settings.cpp:578
msgctxt "page header title"
msgid "Devices"
msgstr "Cihazlar"

#: client/scenes/gui_settings.cpp:578
msgctxt "page header subtitle"
msgid "Forward input devices to the PC."
msgstr "Giriş cihazlarını kompüterə yönləndirin."

#: client/scenes/gui_settings.cpp:582 client/scenes/stream_network.cpp:93
msgid "The server does not allow forwarded input devices"
msgstr "Server yönləndirilən giriş cihazlarına icazə vermir"

#: client/scenes/gui_settings.cpp:598
msgctxt "setting name"
msgid "Posture"
msgstr ""

#: client/scenes/gui_settings.cpp:599
msgid "Posture assumed when a stream connects."
msgstr ""

#: client/scenes/gui_settings.cpp:603
msgctxt "posture"
msgid "Standing"
msgstr ""

#: client/scenes/gui_settings.cpp:603
msgctxt "posture"
msgid "Seated"
msgstr ""

#: client/scenes/gui_settings.cpp:609
msgctxt "setting name"
msgid "Height adjustment"
msgstr ""

#: client/scenes/gui_settings.cpp:611
msgid ""
"Corrects the height reported to the PC when seated, useful for games without "
"native seated support."
msgstr ""

#: client/scenes/gui_settings.cpp:612
msgid ""
"Corrects the height reported to the PC when standing, useful for a "
"miscalibrated floor."
msgstr ""

#: client/scenes/gui_settings.cpp:637
msgctxt "setting name"
msgid "Hand tracking"
msgstr "Əl izləməsi"

#: client/scenes/gui_settings.cpp:637
msgid "Track your hands for input when controllers are down."
msgstr "Kontrollerlər kənara qoyulduqda giriş üçün əllərinizi izləyin."

#: client/scenes/gui_settings.cpp:640
msgctxt "setting name"
msgid "Eye tracking"
msgstr "Göz izləməsi"

#: client/scenes/gui_settings.cpp:640
msgid "Used by foveated encoding to focus quality where you look."
msgstr ""
"Keyfiyyəti baxdığınız yerə cəmləşdirmək üçün foveasiyalı kodlaşdırmada "
"istifadə olunur."

#: client/scenes/gui_settings.cpp:643
msgctxt "setting name"
msgid "Face tracking"
msgstr "Üz izləməsi"

#: client/scenes/gui_settings.cpp:643
msgid "Stream facial expressions to the PC."
msgstr "Üz ifadələrini kompüterə ötürün."

#: client/scenes/gui_settings.cpp:651
msgctxt "virtual body tracker selection"
msgid "Chest"
msgstr "Sinə"

#: client/scenes/gui_settings.cpp:652
msgctxt "virtual body tracker selection"
msgid "Left elbow"
msgstr "Sol dirsək"

#: client/scenes/gui_settings.cpp:653
msgctxt "virtual body tracker selection"
msgid "Right elbow"
msgstr "Sağ dirsək"

#: client/scenes/gui_settings.cpp:654
msgctxt "virtual body tracker selection"
msgid "Hip"
msgstr "Çanaq"

#: client/scenes/gui_settings.cpp:655
msgctxt "virtual body tracker selection"
msgid "Left knee"
msgstr "Sol diz"

#: client/scenes/gui_settings.cpp:656
msgctxt "virtual body tracker selection"
msgid "Right knee"
msgstr "Sağ diz"

#: client/scenes/gui_settings.cpp:657
msgctxt "virtual body tracker selection"
msgid "Left foot"
msgstr "Sol ayaq"

#: client/scenes/gui_settings.cpp:658
msgctxt "virtual body tracker selection"
msgid "Right foot"
msgstr "Sağ ayaq"

#: client/scenes/gui_settings.cpp:673
msgctxt "setting name"
msgid "Body tracking"
msgstr "Bədən izləməsi"

#: client/scenes/gui_settings.cpp:675
msgid ""
"Requires 'Hand and body tracking' to be enabled in the Quest movement "
"tracking settings, otherwise body data will be guessed from controller and "
"headset positions."
msgstr ""
"Quest hərəkət izləməsi parametrlərində 'Əl və bədən izləməsi' "
"aktivləşdirilməlidir, əks halda bədən məlumatları kontroller və qulaqlığın "
"mövqelərinə əsasən təxmin ediləcək."

#: client/scenes/gui_settings.cpp:676
msgid "Stream body joint positions to the PC."
msgstr "Bədən oynaqlarının mövqelərini kompüterə ötürün."

#: client/scenes/gui_settings.cpp:687 client/scenes/gui_settings.cpp:702
msgctxt "setting name"
msgid "Virtual body trackers"
msgstr "Virtual bədən izləyiciləri"

#: client/scenes/gui_settings.cpp:688
msgid "Create virtual tracker devices."
msgstr "Virtual izləmə cihazları yaradın."

#: client/scenes/gui_settings.cpp:708
msgctxt "page header title"
msgid "Tracking"
msgstr "İzləmə"

#: client/scenes/gui_settings.cpp:708
msgctxt "page header subtitle"
msgid "Body and input tracking sent to the PC."
msgstr "Kompüterə göndərilən bədən və giriş izləməsi."

#: client/scenes/gui_settings.cpp:722
msgctxt "language selection, replace with the name of the language"
msgid "English"
msgstr "Azərbaycanca"

#: client/scenes/gui_settings.cpp:745 client/scenes/gui_settings.cpp:759
msgid "Language"
msgstr "Dil"

#: client/scenes/gui_settings.cpp:746
msgctxt "setting name"
msgid "Interface language."
msgstr "İnterfeys dili."

#: client/scenes/gui_settings.cpp:755
msgctxt "item in the interface language combobox"
msgid "System language"
msgstr "Sistem dili"

#: client/scenes/gui_settings.cpp:767
msgctxt "setting name"
msgid "USB networking"
msgstr "USB şəbəkəsi"

#: client/scenes/gui_settings.cpp:768
msgid ""
"Enables connection by USB without ADB or developer mode.\n"
"Make sure the server allows IPv6 link-local only connections."
msgstr ""
"ADB və ya tərtibatçı rejimi olmadan USB ilə əlaqə qurmağa imkan verir.\n"
"Serverin yalnız lokal şəbəkə seqmentində keçərli IPv6 ünvanları ilə "
"əlaqələrə icazə verdiyinə əmin olun."

#: client/scenes/gui_settings.cpp:778
msgctxt "setting name"
msgid "Extended configuration"
msgstr "Genişləndirilmiş konfiqurasiya"

#: client/scenes/gui_settings.cpp:779
msgid "Allows unsafe configuration values, use at your own risk."
msgstr ""
"Təhlükəsiz olmayan konfiqurasiya dəyərlərinə icazə verir, riski nəzərə "
"alaraq istifadə edin."

#: client/scenes/gui_settings.cpp:790
msgid "High power mode"
msgstr "Yüksək güc rejimi"

#: client/scenes/gui_settings.cpp:791
msgid ""
"Increase power usage to allow higher resolution and refresh rate. Drains "
"battery and runs hot."
msgstr ""
"Daha yüksək ayırdetmə qabiliyyəti və yenilənmə tezliyinə imkan vermək üçün "
"enerji istifadəsini artırın. Batareyanı tükədir və cihazı qızdırır."

#: client/scenes/gui_settings.cpp:807
msgctxt "setting name"
msgid "In-stream window"
msgstr "Yayım zamanı pəncərə"

#: client/scenes/gui_settings.cpp:808
msgid ""
"Enables the configuration window to be shown while the game is streaming. If "
"enabled, the window is activated by pressing both thumbsticks."
msgstr ""
"Oyun yayımlanarkən konfiqurasiya pəncərəsinin göstərilməsinə imkan verir. "
"Aktivləşdirildikdə hər iki analoq çubuğa basmaqla pəncərə açılır."

#: client/scenes/gui_settings.cpp:824
msgctxt "page header title"
msgid "System"
msgstr "Sistem"

#: client/scenes/gui_settings.cpp:824
msgctxt "page header suibtitle"
msgid "Language and advanced options."
msgstr "Dil və genişləndirilmiş seçimlər."

#: client/scenes/gui_settings.cpp:837
msgctxt "page header title"
msgid "Theme"
msgstr "Mövzu"

#: client/scenes/gui_settings.cpp:837
msgctxt "page header subtitle"
msgid "Accent color, palette and sizing of the interface."
msgstr "İnterfeysin vurğu rəngi, palitrası və ölçüləri."

#: client/scenes/gui_settings.cpp:845
msgctxt "setting name"
msgid "Accent color"
msgstr "Vurğu rəngi"

#: client/scenes/gui_settings.cpp:879
msgctxt "setting name"
msgid "Preset"
msgstr "Hazır seçim"

#: client/scenes/gui_settings.cpp:879
msgctxt "setting description"
msgid "Surface and background palette"
msgstr "Səth və arxa fon palitrası"

#: client/scenes/gui_settings.cpp:880
msgid "Theme preset"
msgstr "Hazır mövzu"

#: client/scenes/gui_settings.cpp:899
msgctxt "setting label"
msgid "Rounding"
msgstr "Yuvarlaqlıq"

#: client/scenes/gui_settings.cpp:899
msgctxt "setting description"
msgid "Corner radius of controls"
msgstr "İdarəetmə elementlərinin künc radiusu"

#: client/scenes/gui_settings.cpp:911
msgctxt "setting label"
msgid "Card rounding"
msgstr "Kart yuvarlaqlığı"

#: client/scenes/gui_settings.cpp:911
msgctxt "setting description"
msgid "Corner radius of panels"
msgstr "Panellərin künc radiusu"

#: client/scenes/gui_settings.cpp:924
msgctxt "setting name"
msgid "Text size"
msgstr "Mətn ölçüsü"

#: client/scenes/gui_settings.cpp:924
msgctxt "setting description"
msgid "Global font scale"
msgstr "Ümumi şrift miqyası"

#: client/scenes/gui_settings.cpp:937
msgctxt "setting name"
msgid "Panel opacity"
msgstr "Panelin qeyri-şəffaflığı"

#: client/scenes/gui_settings.cpp:937
msgctxt "setting description"
msgid "Opacity of the panel and card backgrounds"
msgstr "Panel və kart arxa fonlarının qeyri-şəffaflığı"

#: client/scenes/lobby.cpp:232
msgid "Incompatible WiVRn server: no protocol field in TXT"
msgstr "Uyğun olmayan WiVRn serveri: TXT-də protokol sahəsi yoxdur"

#: client/scenes/lobby.cpp:235
#, c++-format
msgid "Incompatible WiVRn server protocol (client: {}, server: {})"
msgstr "Uyğun olmayan WiVRn server protokolu (klient: {}, server: {})"

#: client/scenes/lobby.cpp:250
#, c++-format
msgid "Cannot resolve hostname: {}"
msgstr "Qovşaq adı müəyyən edilə bilmir: {}"

#: client/scenes/lobby.cpp:343 client/scenes/lobby.cpp:349
#, c++-format
msgid "Cannot connect to {} ({}): {}"
msgstr "{} ({}) ilə əlaqə qurmaq mümkün deyil: {}"

#: client/scenes/lobby.cpp:432
