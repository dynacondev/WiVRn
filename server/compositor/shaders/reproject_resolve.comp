/*
 * Retained-source resolve for server-side depth reprojection.
 *
 * Copies the current real frame's color + depth into compositor-owned
 * retained images so synthetic frames warp from held sources: the app
 * may recycle or recreate its swapchains at any time, while the
 * retained copy lives until the next real frame refreshes it.
 *
 * Warp math uses mat4 * vec4 only (no mat3 constructors or ternaries):
 * Adreno-740-safe by construction.
 */

#version 450

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D src_color0;
layout(set = 0, binding = 1) uniform sampler2D src_color1;
layout(set = 0, binding = 2) uniform sampler2D src_depth0;
layout(set = 0, binding = 3) uniform sampler2D src_depth1;

layout(set = 0, binding = 4, rgba8) uniform writeonly image2DArray dst_color;
layout(set = 0, binding = 5, r32f) uniform writeonly image2DArray dst_depth;

layout(push_constant) uniform Push
{
	vec4 color_rect[2]; // per-eye normalized sub-image rects
	vec4 depth_rect[2];
	float color_flip; // 1 = mirror color rows (Vulkan-ordered source)
	float depth_flip; // 1 = mirror depth rows (Vulkan-ordered source)
	float src_reverse_z; // 0 = standard depth, 1 = reverse-Z (flip 1-z)
	float pad;
} pc;

void main()
{
	uvec3 id = gl_GlobalInvocationID;
	ivec2 size = imageSize(dst_color).xy;
	if (int(id.x) >= size.x || int(id.y) >= size.y)
		return;
	int eye = int(id.z);

	// Branchless orientation handling (scalar arithmetic only): the
	// retained images are always GL-ordered (row 0 = frustum bottom),
	// so each plane mirrors iff the caller flagged its source rows
	// Vulkan-ordered.
	vec2 guv = (vec2(id.xy) + vec2(0.5)) / vec2(size);
	vec2 color_guv = vec2(guv.x, guv.y + pc.color_flip * (1.0 - 2.0 * guv.y));
	vec2 depth_guv = vec2(guv.x, guv.y + pc.depth_flip * (1.0 - 2.0 * guv.y));

	vec2 color_uv;
	vec2 depth_uv;
	float depth;
	vec4 color;
	if (eye == 0)
	{
		color_uv = pc.color_rect[0].xy + color_guv * pc.color_rect[0].zw;
		depth_uv = pc.depth_rect[0].xy + depth_guv * pc.depth_rect[0].zw;
		color = texture(src_color0, color_uv);
		depth = texture(src_depth0, depth_uv).x;
	}
	else
	{
		color_uv = pc.color_rect[1].xy + color_guv * pc.color_rect[1].zw;
		depth_uv = pc.depth_rect[1].xy + depth_guv * pc.depth_rect[1].zw;
		color = texture(src_color1, color_uv);
		depth = texture(src_depth1, depth_uv).x;
	}

	imageStore(dst_color, ivec3(id.xy, eye), color);
	// Reverse-Z (1 at near) -> standard (0 at near) once, here, so the
	// warp math stays standard-convention downstream.
	depth = mix(depth, 1.0 - depth, pc.src_reverse_z);
	imageStore(dst_depth, ivec3(id.xy, eye), vec4(depth, 0.0, 0.0, 0.0));
}
