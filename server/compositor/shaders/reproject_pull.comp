/*
 * Color pull (pass 2 of the compute backward warp).
 *
 * One thread per target pixel: reads the splatted foreground depth,
 * unprojects with the target inverses and reprojects with the source
 * projection, then taps the retained color. Disoccluded pixels (no
 * valid splat) are filled by an expanding-ring search for the nearest
 * valid splat, up to HOLE_RADIUS; anything still invalid keeps black.
 *
 * Warp math follows the OpenWarp family (https://github.com/Zee2/openwarp,
 * NCSA-licensed); the splat/pull structure is original.
 */

#version 450

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D src_color;

layout(set = 0, binding = 1) uniform PullUBO
{
	mat4 dst_inv; // target clip -> world (inverse view * inverse projection, folded on CPU)
	mat4 src_vp; // source projection * source view, folded on CPU
	float hole_radius; // max expanding-ring radius for hole fill (0 = black)
	float pad[3];
} ubo;

layout(set = 0, binding = 2, r32ui) uniform uimage2D splat_depth;

layout(set = 0, binding = 3, rgba8) uniform writeonly image2D dst_color;

#define DEPTH_SCALE 16777215.0
#define SPLAT_EMPTY 0xffffffffu

// Reproject a target pixel (tuv in 0..1, standard depth z) back to a
// source UV. Returns false when the point is behind the source camera.
bool source_uv(vec2 tuv, float z, out vec2 suv)
{
	vec4 clip_pos = vec4(tuv * 2.0 - 1.0, z * 2.0 - 1.0, 1.0);
	vec4 frag_worldspace = ubo.dst_inv * clip_pos;
	vec4 src_clip = ubo.src_vp * frag_worldspace;
	if (src_clip.w <= 0.0)
		return false;
	suv = (src_clip.xy / src_clip.w) * 0.5 + 0.5;
	return true;
}

bool in_bounds(vec2 uv)
{
	return uv.x >= 0.0 && uv.x <= 1.0 && uv.y >= 0.0 && uv.y <= 1.0;
}

void main()
{
	ivec2 dst_xy = ivec2(gl_GlobalInvocationID.xy);
	ivec2 size = imageSize(dst_color);
	if (dst_xy.x >= size.x || dst_xy.y >= size.y)
		return;
	vec2 tuv = (vec2(dst_xy) + vec2(0.5)) / vec2(size);

	vec2 suv = vec2(0.0);
	bool ok = false;

	uint enc = imageLoad(splat_depth, dst_xy).x;
	if (enc != SPLAT_EMPTY) {
		float depth = float(enc) / DEPTH_SCALE;
		if (source_uv(tuv, depth, suv) && in_bounds(suv))
			ok = true;
	}

	if (!ok) {
		// Expanding-ring search for the nearest valid splat. Ring r
		// covers the perimeter only, so cost grows with the hole edge,
		// not its area. Keeps the DEEPEST candidate in the nearest
		// non-empty ring (background stretch): the nearest valid splat
		// to a disocclusion is usually the occluding foreground edge,
		// and smearing it reads as fringing.
		int rmax = int(ubo.hole_radius + 0.5);
		vec2 best_suv = vec2(0.0);
		float best_depth = -1.0;
		for (int r = 1; r <= rmax && best_depth < 0.0; r++) {
			for (int dy = -r; dy <= r; dy++) {
				for (int dx = -r; dx <= r; dx++) {
					if (max(abs(dx), abs(dy)) != r)
						continue;
					ivec2 nxy = dst_xy + ivec2(dx, dy);
					if (nxy.x < 0 || nxy.y < 0 || nxy.x >= size.x || nxy.y >= size.y)
						continue;
					uint nenc = imageLoad(splat_depth, nxy).x;
					if (nenc == SPLAT_EMPTY)
						continue;
					float ndepth = float(nenc) / DEPTH_SCALE;
					vec2 nsuv = vec2(0.0);
					vec2 nuv = (vec2(nxy) + vec2(0.5)) / vec2(size);
					if (ndepth > best_depth && source_uv(nuv, ndepth, nsuv) && in_bounds(nsuv)) {
						best_suv = nsuv;
						best_depth = ndepth;
					}
				}
			}
		}
		if (best_depth >= 0.0) {
			suv = best_suv;
			ok = true;
		}
	}

	if (!ok) {
		imageStore(dst_color, dst_xy, vec4(0.0));
		return;
	}

	vec4 color = texture(src_color, suv);
	imageStore(dst_color, dst_xy, color);
}
